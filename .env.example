# Copy this file to .env for local development only.
# NEVER commit .env to GitHub.
TOSS_CLIENT_ID=your_client_id_here
TOSS_CLIENT_SECRET=your_client_secret_here

# Public deployment defaults
ALLOW_DEMO=false
MAX_REALTIME_SYMBOLS=90
MAX_BROWSER_WS_CLIENTS=250
SNAPSHOT_CACHE_SECONDS_1M=5
SNAPSHOT_CACHE_SECONDS_1D=15
SNAPSHOT_MIN_INTERVAL_SECONDS=0.12
MAX_MARKET_CACHE_ENTRIES=512
